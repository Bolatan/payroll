# MongoDB Atlas connection string (allow Vercel access in Atlas Network Access)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/payroll?retryWrites=true&w=majority

# Secret used to sign login tokens. At least 32 random characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# First administrator. Used only while the users collection is empty, on the first sign-in.
# Sign in with these, set a new password when prompted, then DELETE these three variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe2026now
ADMIN_NAME=System Administrator

# Open question Q2: monthly hours used to derive hourly rate (22 days x 8h)
HOURS_PER_MONTH=176
